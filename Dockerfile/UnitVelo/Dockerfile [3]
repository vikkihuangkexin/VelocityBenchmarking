# 使用NVIDIA官方的CUDA镜像作为基础，确保GPU驱动兼容性
# 你可以根据你的NVIDIA驱动版本选择更合适的CUDA版本
# 例如 nvidia/cuda:11.8.0-devel-ubuntu22.04
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

# 设置环境变量，避免安装过程中的交互式提问
ENV DEBIAN_FRONTEND=noninteractive

ARG USERNAME=user1
ARG PASSWORD=080528
ARG USER_UID=1000
ARG USER_GID=1000


# 更新系统并安装必要的工具
RUN apt-get update && \
    apt-get install -y wget bzip2 ca-certificates git
RUN apt-get install sudo
RUN apt-get -y install openssh-server gosu
RUN apt-get -y install vim
RUN apt-get install -y iproute2
RUN apt-get install -y htop
RUN rm -rf /var/lib/apt/lists/*

# 創建一個非 root 用戶
# -m: 創建主目錄
# -s: 指定默認 shell
# -u, -g: 指定 UID 和 GID
RUN groupadd --gid ${USER_GID} ${USERNAME} && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME}
RUN echo "${USERNAME}:${PASSWORD}" | chpasswd
# 給新用戶設置 sudo 權限（可選，但很方便）
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- SSH 配置 ---

# 1. 為 SSH 服務創建必要的目錄
RUN mkdir -p /var/run/sshd \
    && echo "PermitRootLogin yes" >> /etc/ssh/sshd_config \
    && echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config\
    && echo "Port 22" >> /etc/ssh/sshd_config

COPY start.sh /start.sh

# 2. 給予腳本可執行權限 (非常重要！)
RUN chmod +x /start.sh

# 暴露容器的 22 端口
EXPOSE 22

# === 新增 ===
# 为挂载数据创建目录
RUN mkdir -p /data/simdata

COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# 安装 Miniconda
ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p $CONDA_DIR && \
    rm ~/miniconda.sh
ENV PATH=$CONDA_DIR/bin:$PATH

# 初始化Conda，使其在bash shell中可用
RUN conda init bash

# 创建一个欢迎脚本，列出所有可用的环境
RUN echo 'display_resources() { \
    echo "CPU 线程数: $(grep -c '"'"'^processor'"'"' /proc/cpuinfo)"; \
    mem_total_kb=$(grep '"'"'MemTotal'"'"' /proc/meminfo | awk '"'"'{print $2}'"'"'); \
    echo "总内存: $(echo "$mem_total_kb" | awk '"'"'{printf "%.2f GB", $1/1024/1024}'"'"')"; \
    mem_limit_bytes=$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null); \
    if [ "$mem_limit_bytes" -ge 9223372036854771712 ]; then \
        echo "内存限制: 无限制"; \
    else \
        echo "内存限制: $(echo "$mem_limit_bytes" | awk '"'"'{printf "%.2f GB", $1/1024/1024/1024}'"'"')"; \
    fi; \
    cpu_quota=$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us 2>/dev/null); \
    cpu_period=$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us 2>/dev/null); \
    if [ "$cpu_quota" = -1 ]; then \
        echo "CPU 限制: 无限制"; \
    else \
        echo "CPU 限制: ${cpu_quota}/${cpu_period} ($(echo "scale=2; $cpu_quota / $cpu_period" | bc) 核)"; \
    fi \
}' >> /etc/bash.bashrc && \
    echo 'echo "欢迎进入单细胞分析环境！"' >> /etc/bash.bashrc && \
    echo 'echo "您可以使用 conda activate <env_name> 来激活特定环境。"' >> /etc/bash.bashrc && \
    echo 'echo "可用的环境包括: velocyto, scvelo, velovi, celldancer, unitvelo"' >> /etc/bash.bashrc && \
    echo 'echo "数据已从宿主机挂载到 /data/simdata"' >> /etc/bash.bashrc && \
    echo 'echo "容器资源信息:"' >> /etc/bash.bashrc && \
    echo 'display_resources' >> /etc/bash.bashrc

# =========================================================================
# 为每个包创建独立的环境
# =========================================================================

# 1. Velocyto
RUN conda create -n velocyto -c conda-forge --yes python=3.8.0 && \
    /bin/bash -c "source $CONDA_DIR/bin/activate velocyto && pip install numpy GPUtil Cython && \
    pip install velocyto scvelo==0.2.5"

# 2. scVelo
RUN conda create -n scvelo -c conda-forge --yes python=3.8.0 && \
    /bin/bash -c "source $CONDA_DIR/bin/activate scvelo && pip install scvelo==0.2.5 GPUtil"

# 3. VeloVI
RUN conda create -n velovi --yes python=3.8.0 && \
    /bin/bash -c "source $CONDA_DIR/bin/activate velovi && \
    conda install --yes pytorch torchvision torchaudio pytorch-cuda=11.8 -c pytorch -c nvidia && \
    conda install --yes -c conda-forge scvi-tools && \
    pip install velovi GPUtil scvelo==0.2.5"
    # flax==0.5.3 jax==0.4.13 jaxlib==0.4.13 scipy==1.12.0

# 4. CellDancer
RUN conda create -n CD -c conda-forge --yes python=3.7.6 && \
    /bin/bash -c "source $CONDA_DIR/bin/activate CD && pip install celldancer GPUtil scvelo==0.2.5"

# 5. unitvelo
RUN conda create -n unitvelo --yes python=3.8.0 && \
    /bin/bash -c "source $CONDA_DIR/bin/activate unitvelo && pip install unitvelo scvelo==0.2.5 GPUtil tensorflow==2.4.1 numba==0.57.1 numpy==1.21.1"
    ###docker pull nvcr.io/nvidia/tensorflow:24.07-tf2-py3
USER root
# 保证 .bashrc 存在并属于 user1
RUN touch /home/user1/.bashrc \
 && chown user1:user1 /home/user1/.bashrc
# 追加环境变量，让 activate/conda 在 PATH 中
RUN echo 'export PATH=/opt/conda/bin:$PATH' >> /home/user1/.bashrc \
 && echo '. /opt/conda/etc/profile.d/conda.sh' >> /home/user1/.bashrc \
 && chown user1:user1 /home/user1/.bashrc


# 设置默认的启动命令，当容器启动时，自动进入bash shell
#-D: 在前台運行 sshd，防止容器立即退出
CMD ["/start.sh"]